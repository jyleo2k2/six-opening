{
  "name": "six-opening",
  "version": "0.1.0",
  "private": true,
  "description": "키즈:키움 — 자녀용 영웅문 (PvP 카드게임 · 도감/뉴스 · 투자 제안서)",
  "workspaces": [
    "game",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "server": "npm run server -w game",
    "test": "npm run test -w game",
    "sim": "npm run sim -w game",
    "typecheck": "npm run typecheck -w game && npm run typecheck -w web",
    "build": "npm run build -w web"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
