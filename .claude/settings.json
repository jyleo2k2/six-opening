{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/git-session-manager.mjs guard --hook-input",
            "timeout": 30,
            "statusMessage": "브랜치·worktree·claim 범위를 확인하는 중..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/git-session-manager.mjs check-start",
            "timeout": 30,
            "statusMessage": "병렬 Git 작업 세션을 확인하는 중..."
          }
        ]
      }
    ]
  }
}
