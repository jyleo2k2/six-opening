# Copy this file to .env.kiwoom.local and fill in your credentials.
KIWOOM_APP_KEY=your_app_key
KIWOOM_SECRET_KEY=your_secret_key
# real: 실전투자, mock: 모의투자
KIWOOM_ENV=real
KIWOOM_STOCK_CODES=005930
KIWOOM_WS_SECONDS=20
# 30종목 대시보드 로컬 포트
KIWOOM_DASHBOARD_PORT=8787
# 키움 REST API 유량 제한 대응(최소 1000ms)
KIWOOM_REST_INTERVAL_MS=1100
