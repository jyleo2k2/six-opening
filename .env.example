# .env로 복사해 값을 채운다. 실제 키는 커밋하거나 NEXT_PUBLIC_으로 노출하지 않는다.

OPENAI_API_KEY=your_openai_api_key

# 시세 제공자 선택. 값을 바꾸면 서버를 다시 켜야 반영된다.
# QUOTE_PROVIDER 를 먼저 시도하고, 키가 없거나 호출이 실패하면 FALLBACK 으로 넘어간다.
# 둘 다 못 쓰면 보관 캔들 → 픽스처 순으로 내려가므로 화면이 비지는 않는다.
QUOTE_PROVIDER=kiwoom
QUOTE_PROVIDER_FALLBACK=toss

KIWOOM_APP_KEY=your_kiwoom_app_key
KIWOOM_SECRET_KEY=your_kiwoom_secret_key
KIWOOM_ENV=mock

TOSS_CLIENT_ID=your_toss_client_id
TOSS_CLIENT_SECRET=your_toss_client_secret
# 아래 값은 토스 규격이 확정되면 채운다. 비우면 web/app/api/quote/providers/toss.ts 의
# 기본값(가정)을 쓴다. 코드를 고치지 않고 여기서 경로만 바꿀 수 있다.
# TOSS_BASE_URL=https://openapi.tossinvest.com
# TOSS_TOKEN_PATH=/oauth2/token
# TOSS_QUOTE_PATH=/v1/quotes/{symbol}
# TOSS_CANDLE_PATH=/v1/candles/{symbol}
# 요청 사이 최소 간격(ms). 키움은 2600 고정, 토스는 실제 한도에 맞춰 조절한다.
# TOSS_REQUEST_INTERVAL_MS=200

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
