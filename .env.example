# ============================================================
#  영웅 키움 — 환경변수 템플릿 (이 파일은 커밋됨, 실제 키 넣지 말 것)
#  사용법: 복사해서 .env 를 만들고 실제 값을 채운다.
#     Mac/Linux:  cp .env.example .env
#     Windows PS: Copy-Item .env.example .env
#
#  ⚠️ .env 는 절대 커밋 금지 (.gitignore 로 차단). 실제 키는 각자 로컬에만.
#  ⚠️ 전부 서버 전용이다. `NEXT_PUBLIC_` 접두사를 붙이면 브라우저 번들에
#     그대로 실려 나가므로 어떤 키에도 붙이지 않는다. (docs/기술스택.md)
#
#  위치: 레포 루트의 .env 하나만 쓴다. 앱은 web/ 에서 실행되고
#  web/shared/llm/client.ts 가 dotenv 로 ../.env 를 읽는다.
# ============================================================

# ── LLM (F9 성향 서술 · F10 챗봇 키웅이) ──
# 모델은 gpt-5.6-luna 고정. 모델 ID는 코드 상수(web/shared/llm/client.ts)라
# 환경변수로 바꾸지 않는다 — 별칭 gpt-5.6 은 sol 로 라우팅되므로 금지.
# 비어 있으면 챗봇의 LLM 경로가 예외로 떨어지고 고정 폴백 문구만 나온다.
# (사전·FAQ 매칭 답변과 선제 발화는 키 없이도 동작한다.)
OPENAI_API_KEY=                    # 발급: https://platform.openai.com/api-keys

# ── 시세 (키움 REST API) ──
# 국내주식 현재가·차트. 자격증명이 없거나 값이 your_ 로 시작하면
# web/app/api/quote 가 자동으로 픽스처 시세로 폴백한다 — 발표가 장외여도 데모는 돈다.
KIWOOM_APP_KEY=your_app_key        # 발급: https://openapi.kiwoom.com
KIWOOM_SECRET_KEY=your_secret_key
# mock  = 모의투자 서버 (https://mockapi.kiwoom.com)
# real  = 실서버 (https://api.kiwoom.com) — 미지정 시 기본값
KIWOOM_ENV=mock
